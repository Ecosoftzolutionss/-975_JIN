<UserControl x:Class="DSM.Views.ReprocessView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:local="clr-namespace:DSM.Views"
           mc:Ignorable="d" d:DesignHeight="730" d:DesignWidth="1200" Background="#ccff99">
    <Grid Margin="60,0,0,0" Height="1000">


        <StackPanel Grid.Row="0" Margin="0,10,53,290">
            <TextBlock  HorizontalAlignment="Center"  Text=" Invoice Reprocess" Foreground="#33331a" FontSize="20" FontWeight="Bold" FontFamily="Century" Height="30" Margin="326,0,378,0" Width="300" VerticalAlignment="Center"></TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="0" Margin="38,60,24,140" Height="800">
            <TextBlock x:Name="textBlock" TextWrapping="Wrap" Text="FILE TO REPROCESS :" FontSize="15" Foreground="#33331a" Height="34" Margin="93,0,563,0" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0,15,0,0" Width="411" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.09"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBox x:Name="FilePath" Height="35" TextWrapping="Wrap" Text="{Binding SearchInvoiceNo, Mode=TwoWay}" Margin="284,-27,291,0"/>
            <Button x:Name="Browse" Content="BROWSE" FontSize="15" Command="{Binding BrowseCommand}" Height="34" Margin="731,-40,182,0" Background="#FF63686E" BorderBrush="Black" Click="Browse_Click" Foreground="White"/>
            <Button x:Name="PROCESS" Content="START PROCESS" Command="{Binding SearchCommand}" FontSize="15" Height="35" Margin="426,10,425,0" Background="#FF63686E" BorderBrush="Black" Foreground="White" />

        </StackPanel>
        <Border HorizontalAlignment="Center" Grid.Column="0" Margin="99,243,99,-76" Height="833" VerticalAlignment="Top">
            <StackPanel Margin="-100,-68,0,409">
                <DataGrid x:Name="dgPending" Background="#FF63686E" Height="527" FontSize="14" ItemsSource="{Binding InvoiceList}" SelectedItem="{Binding SelectedReprint}" AutoGenerateColumns="False" CanUserAddRows="False"  Margin="0" VerticalScrollBarVisibility="Auto" Width="1100" SelectionChanged="dgPending_SelectionChanged" RenderTransformOrigin="0.499,0.566" HorizontalAlignment="Left">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE NO" IsReadOnly="True" Binding="{Binding InvNumber}" Width="100"/>
                        <DataGridTextColumn Header="INVOICE DATE" IsReadOnly="True" Binding="{Binding InvDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="SIGN STATUS" IsReadOnly="True" Binding="{Binding DSStatus}" Width="110"/>
                        <DataGridTextColumn Header="PRINT STATUS" IsReadOnly="True" Binding="{Binding PrintStatus}" Width="110"/>
                        <DataGridTextColumn Header="API STATUS" IsReadOnly="True" Binding="{Binding ApiStatus}" Width="110"/>
                        <DataGridTextColumn Header="API MESSAGE" IsReadOnly="True" Binding="{Binding ApiMsg}" Width="250"/>
                        <DataGridTemplateColumn Header="ACTION"  Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!--<Button x:Name="btnDeleteCustomer" Content="Delete" Margin="5,0,0,0" FontSize="12" Width="90"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.DeleteCustomerKeyCommand}" />-->
                                        <Button x:Name="btnReprint" Content="REPRINT" Margin="0,0,0,0" FontSize="12" Width="90"
                                            Command="{Binding DataContext.ReprintCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="DataMsg" Text="{Binding DataMsg}"  HorizontalAlignment="Center" Margin="0,-300,0,0" Width="148" Height="34"/>
            </StackPanel>
        </Border>


    </Grid>
</UserControl>
