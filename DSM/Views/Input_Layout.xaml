<UserControl x:Class="DSM.Views.Input_Layout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism ="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:local="clr-namespace:DSM.Views"
         Height="730" Width="1200" FontSize="14" Loaded="UserControl_Loaded">

    <Grid Margin="0,0,-18,0">
        <!--<wpfTool:WatermarkTextBox  x:Name="UsernameTextBox" 
                                   Width="600"
                                   Height="100"
                                   Text="{Binding UserName}"
                                   Watermark="Username"
                                   Cursor="IBeam" 
                                   FontFamily="Quicksand" 
                                   FontSize="72"/>-->
        <!--<SolidColorBrush x:Key="brushWatermarkForeground" Color="LightSteelBlue" />-->
        <!--<TabControl Name="MainTab">
        </TabControl>-->

        <Canvas Background="#ccff99" Margin="12,8,108,-10">
            <!--<ListBox Height="128" Width="120" Canvas.Left="38" Canvas.Top="46">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Name="CheckBoxZone" >
                            
                        </CheckBox>
                       
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>-->

            <TextBox x:Name="FilePath" HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" VerticalAlignment="Top" Width="310" FontSize="12" FontFamily="Century Gothic" Canvas.Left="328" Canvas.Top="84" Background="Transparent" Foreground="Black"/>
            <Button Name="Browse_btn" Content="Browse" HorizontalAlignment="Left" VerticalAlignment="Top" Width="115" FontSize="12" FontFamily="Century Gothic" Canvas.Left="662" Canvas.Top="86" Background="White" Height="22" Click="Browse_btn_Click" BorderThickness="2" RenderTransformOrigin="0.509,1.167"/>

            <Label Content="Co-Ordinates :" HorizontalAlignment="Left" VerticalAlignment="Top" Width="98" FontSize="12" FontFamily="Century Gothic" Foreground="#33331a" Canvas.Left="843" Canvas.Top="27"/>
            <Label x:Name="find_lbl" Content="Find Text" HorizontalAlignment="Left" VerticalAlignment="Top" Width="86" FontSize="12" FontFamily="Century Gothic" Canvas.Left="193" Canvas.Top="151" Foreground="#33331a"/>
            <TextBlock
                Text=""
                Foreground="Black"
                Width="310" Height="23" FontSize="12" FontFamily="Century Gothic"
                Name="txtHintPassword" Visibility="Visible" Canvas.Left="309" Canvas.Top="151"/>
            <!--<Label Name="adminEmailHint" Margin="122,113" Foreground="Red" Width="310" Height="23" Padding="6"  FontSize="14">Admin Email</Label>-->
            <TextBox x:Name="Search_txt" HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" VerticalAlignment="Top" Width="310" FontSize="12" FontFamily="Century Gothic" Canvas.Left="328" Canvas.Top="151" Background="Transparent" BorderThickness="2" BorderBrush="White" TextChanged="Search_txt_TextChanged"/>
            <!--<Label Name="adminEmailHint" Foreground="LightGray" Padding="6"  FontSize="14">Admin Email</Label>
            <TextBox Padding="4,7,4,8" Background="Transparent" TextChanged="adminEmail_TextChanged" Height="31" x:Name="adminEmail" Width="180" />-->
            <Button x:Name="Coord_btn" Content="Get Co-Ordinates" HorizontalAlignment="Left" VerticalAlignment="Top" Width="115" FontSize="12" FontFamily="Century Gothic" Click="Coord_btn_Click" Height="22" Canvas.Left="662" Canvas.Top="151" Background="White" BorderThickness="2"/>
            <TextBox x:Name="Left_txt" HorizontalAlignment="Left" Height="22" TextWrapping="Wrap" VerticalAlignment="Top" Width="74" IsEnabled="False" FontSize="12" FontFamily="Century Gothic" Background="Transparent" RenderTransformOrigin="1.764,0.931" Canvas.Left="800" Canvas.Top="86" Foreground="Black" FontWeight="Bold"/>
            <TextBox x:Name="Right_txt" HorizontalAlignment="Left" Height="22" TextWrapping="Wrap" VerticalAlignment="Top" Width="72" IsEnabled="False" FontSize="12" FontFamily="Century Gothic" Background="Transparent" Canvas.Left="890" Canvas.Top="86" Foreground="Black" FontWeight="Bold"/>
            <TextBox x:Name="Bott_txt" HorizontalAlignment="Left" Height="22" TextWrapping="Wrap" VerticalAlignment="Top" Width="74" IsEnabled="False" FontSize="12" FontFamily="Century Gothic" Background="Transparent" Canvas.Left="800" Canvas.Top="151" Foreground="Black" FontWeight="Bold"/>
            <TextBox x:Name="Top_txt" HorizontalAlignment="Left" Height="22" TextWrapping="Wrap" VerticalAlignment="Top" Width="72" IsEnabled="False" FontSize="12" FontFamily="Century Gothic" RenderTransformOrigin="0.5,0.5" Background="Transparent" Canvas.Left="890" Canvas.Top="151" Foreground="Black" FontWeight="Bold"/>
            <Label Content="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Height="22" Width="37" FontSize="12" FontFamily="Century Gothic" Foreground="#33331a" Canvas.Left="820" Canvas.Top="52"/>
            <Label Content="Right" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12" FontFamily="Century Gothic" Foreground="#33331a" Canvas.Left="906" Canvas.Top="51" Height="22"/>
            <Label Content="Bottom" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12" FontFamily="Century Gothic" Foreground="#33331a" Canvas.Left="810" Canvas.Top="119" Height="22"/>
            <Label Content="Top" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12" FontFamily="Century Gothic" Foreground="#33331a" Canvas.Left="911" Canvas.Top="119" RenderTransformOrigin="0.597,2.6" Height="28"/>
            <Button x:Name="Locate_btn" Content="Locate" HorizontalAlignment="Left" VerticalAlignment="Top" Width="74" Height="22" FontSize="12" FontFamily="Century Gothic" Background="White" BorderThickness="2" Canvas.Left="980" Canvas.Top="119" Click="Locate_btn_Click"/>
            <Button x:Name="Save_btn" Content="Save" HorizontalAlignment="Left" VerticalAlignment="Top" Width="74" FontSize="12" FontFamily="Century Gothic" Height="22" Canvas.Left="979" Canvas.Top="151" Background="White" Click="Save_btn_Click" BorderThickness="2"/>
            <Button x:Name="Edit_btn" Content="Edit" HorizontalAlignment="Left" VerticalAlignment="Top" Width="74" Height="22" FontSize="12" FontFamily="Century Gothic" Background="White" BorderThickness="2" Canvas.Left="979" Canvas.Top="86" Click="Edit_btn_Click"/>

            <Button x:Name="Extract_btn" Content="Extract" HorizontalAlignment="Left" VerticalAlignment="Top" Width="74" Height="22" FontSize="12" FontFamily="Century Gothic"  Background="White" BorderBrush="#004d66" BorderThickness="2" Canvas.Left="979" Canvas.Top="50" Click="Extract_btn_Click"/>

            <Label x:Name="choose_lbl" Content="Choose File" Canvas.Left="193" Canvas.Top="84" Width="86" FontSize="12" FontFamily="Century Gothic" Foreground="#33331a" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Label Content="INPUT LAYOUT" Canvas.Left="23" Canvas.Top="10" Width="318" Height="28" FontSize="16" FontFamily="Lucida Sans" FontWeight="Bold" Foreground="Black"/>
            <Label Content="------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" Canvas.Top="180" Height="30" Width="1464" Foreground="Black"/>
            <Label x:Name="available_lbl" Content="Available Templates" Canvas.Left="193" Canvas.Top="116" Foreground="#33331a" FontFamily="Century Gothic" FontSize="12" Width="148" Height="31" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <!--<ComboBox Canvas.Left="290" Name="ClientId" Canvas.Top="62" Width="310" Background="Transparent"/>-->
            <!--<ComboBox x:Name="cbCustomers" VerticalAlignment="Center" Width="320" 
                      ItemsSource="{Binding Path=Customers}"     
                      SelectedValuePath="{Binding Customer, Mode=TwoWay}"
                      SelectedValue="{Binding Customer, Mode=TwoWay}" DisplayMemberPath="CustomerName"
                      Background="Transparent" Foreground="Black"/>-->
            <ComboBox  Name="ComboBoxZone" Canvas.Left="328" Width="310" ItemsSource="{Binding}" Foreground="Black" Visibility="Visible" Canvas.Top="116"/>
            <Button x:Name="view_btn" Content="View Existing" Canvas.Left="662" Width="115" FontFamily="Century Gothic" FontSize="12" Click="view_btn_Click" Canvas.Top="119" RenderTransformOrigin="0.522,1.684" Height="22" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="2"/>


            <RadioButton Name="Inv_no_chk" Canvas.Left="38" Canvas.Top="44" Content="Invoice Number" Foreground="#33331a" Checked="Inv_no_chk_Checked" />
            <RadioButton Name="Inv_date_chk" Content="Invoice Date" Canvas.Left="38" Canvas.Top="67" Foreground="#33331a"/>
            <RadioButton Name="Vendor_chk" Content="Vendor code" Canvas.Left="38" Canvas.Top="89" Foreground="#33331a" />
            <RadioButton Name="Truck_chk" Content="Truck Number" Canvas.Left="38" Canvas.Top="113" Foreground="#33331a"/>
            <RadioButton Name="Client_chk" Content="Client Name" Canvas.Left="38" Canvas.Top="135" Foreground="#33331a"/>
            <RadioButton Name="DS_chk" Content="Digital Signature" Canvas.Left="38" Canvas.Top="156" Foreground="#33331a"/>
            <RadioButton Name="shop_cd_chk" Content="Shop Code" Canvas.Left="38" Canvas.Top="178" Foreground="#33331a"/>
            <Label Content="Template Name" Canvas.Left="193" Canvas.Top="51" Foreground="#33331a" FontSize="12" FontFamily="Century Gothic" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBox x:Name="Temp_name" Height="23" Canvas.Left="328" TextWrapping="Wrap" Canvas.Top="51" Width="310" Background="Transparent" Foreground="Black" FontFamily="Century Gothic" FontSize="12"/>
            <Button x:Name="Add_btn" Content="Add" HorizontalAlignment="Left" VerticalAlignment="Top" Width="115" FontSize="12" FontFamily="Century Gothic" Canvas.Left="662" Canvas.Top="51" Background="White" Height="22" Click="Add_btn_Click" BorderThickness="2" RenderTransformOrigin="0.509,1.167"/>
        </Canvas>
        <WebBrowser Name="pdfviewer" Margin="24,215,116,10"/>



    </Grid>
</UserControl>
